generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  pages         Page[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id          String   @id @default(cuid())
  coverImage  String?
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations PostTranslation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations PageTranslation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Locale {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  flag      String?
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  posts     PostTranslation[]
  pages     PageTranslation[]
  menuItems MenuItemTranslation[]
  sections  SiteSectionTranslation[]
  projects  ProjectTranslation[]
  skillCategories SkillCategoryTranslation[]
  skills    Skill[]
  experienceItems ExperienceItemTranslation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostTranslation {
  id          String   @id @default(cuid())
  postId      String
  localeId    String
  title       String
  slug        String
  excerpt     String?
  content     String
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@unique([slug, localeId])
  @@unique([postId, localeId])
}

model PageTranslation {
  id          String   @id @default(cuid())
  pageId      String
  localeId    String
  title       String
  slug        String
  content     String
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@unique([slug, localeId])
  @@unique([pageId, localeId])
}

model Menu {
  id        String      @id @default(cuid())
  key       String      @unique
  items     MenuItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model MenuItem {
  id        String               @id @default(cuid())
  menuId    String
  parentId  String?
  order     Int
  href      String
  isActiveGlobal Boolean         @default(true)
  menu      Menu                 @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    MenuItem?            @relation("MenuItemParent", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[]           @relation("MenuItemParent")
  labels    MenuItemTranslation[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model MenuItemTranslation {
  id         String   @id @default(cuid())
  menuItemId String
  localeId   String
  label      String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  locale   Locale   @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, localeId])
}

model SiteSection {
  id        String                  @id @default(cuid())
  key       String                  @unique
  order     Int
  content   SiteSectionTranslation[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model SiteSectionTranslation {
  id        String   @id @default(cuid())
  sectionId String
  localeId  String
  title     String
  subtitle  String?
  body      String?
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section SiteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  locale  Locale      @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@unique([sectionId, localeId])
}

model Project {
  id          String               @id @default(cuid())
  coverImage  String?
  links       ProjectLink[]
  impacts     ProjectImpact[]
  translations ProjectTranslation[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ProjectTranslation {
  id          String   @id @default(cuid())
  projectId   String
  localeId    String
  title       String
  slug        String
  category    String
  meta        String?
  description String
  problem     String?
  solution    String?
  result      String?
  impact      Json?
  stack       Json?
  tags        Json?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale  Locale  @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@unique([slug, localeId])
  @@unique([projectId, localeId])
}

model ProjectLink {
  id        String   @id @default(cuid())
  projectId String
  label     String
  url       String
  icon      String
  order     Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectImpact {
  id        String   @id @default(cuid())
  projectId String
  label     String
  order     Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SkillCategory {
  id          String                   @id @default(cuid())
  icon        String
  order       Int
  skills      Skill[]
  translations SkillCategoryTranslation[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model SkillCategoryTranslation {
  id            String   @id @default(cuid())
  skillCategoryId String
  localeId      String
  title         String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  skillCategory SkillCategory @relation(fields: [skillCategoryId], references: [id], onDelete: Cascade)
  locale        Locale        @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@unique([skillCategoryId, localeId])
}

model Skill {
  id              String         @id @default(cuid())
  skillCategoryId String
  localeId        String
  label           String
  order           Int
  skillCategory   SkillCategory  @relation(fields: [skillCategoryId], references: [id], onDelete: Cascade)
  locale          Locale         @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@index([skillCategoryId, localeId])
}

model ExperienceItem {
  id           String                    @id @default(cuid())
  order        Int
  companyUrl   String?
  icon         String?
  translations ExperienceItemTranslation[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ExperienceItemTranslation {
  id             String   @id @default(cuid())
  experienceItemId String
  localeId       String
  role           String
  company        String
  period         String
  description    String?
  achievements   Json?
  stack          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  experienceItem ExperienceItem @relation(fields: [experienceItemId], references: [id], onDelete: Cascade)
  locale         Locale         @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@unique([experienceItemId, localeId])
}
